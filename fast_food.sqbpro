lue="59"/><column index="3" value="58"/><column index="4" value="59"/><column index="5" value="36"/><column index="6" value="90"/><column index="7" value="89"/><column index="8" value="42"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">BEGIN TRANSACTION;



-- =========================

-- 1) PARENT CATEGORIES (no duplicates)

-- =========================

INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Lavash','Лаваш',NULL

WHERE NOT EXISTS (

  SELECT 1 FROM &quot;category&quot;

  WHERE parent IS NULL AND name_uz='Lavash'

);



INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Burger','Бургер',NULL

WHERE NOT EXISTS (

  SELECT 1 FROM &quot;category&quot;

  WHERE parent IS NULL AND name_uz='Burger'

);



INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Donar','Донар',NULL

WHERE NOT EXISTS (

  SELECT 1 FROM &quot;category&quot;

  WHERE parent IS NULL AND name_uz='Donar'

);



INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Ichimliklar','Напитки',NULL

WHERE NOT EXISTS (

  SELECT 1 FROM &quot;category&quot;

  WHERE parent IS NULL AND name_uz='Ichimliklar'

);



INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Desert','Десерты',NULL

WHERE NOT EXISTS (

  SELECT 1 FROM &quot;category&quot;

  WHERE parent IS NULL AND name_uz='Desert'

);



-- =========================

-- 2) CHILD CATEGORIES (no duplicates)

-- =========================



-- Lavash children

INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Klassik lavash','Классический лаваш', p.id

FROM &quot;category&quot; p

WHERE p.parent IS NULL AND p.name_uz='Lavash'

AND NOT EXISTS (

  SELECT 1 FROM &quot;category&quot; c

  WHERE c.parent = p.id AND c.name_uz='Klassik lavash'

);



INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Sirli lavash','Сырный лаваш', p.id

FROM &quot;category&quot; p

WHERE p.parent IS NULL AND p.name_uz='Lavash'

AND NOT EXISTS (

  SELECT 1 FROM &quot;category&quot; c


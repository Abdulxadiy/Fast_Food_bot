INSERT INTO &quot;category&quot; (&quot;name_uz&quot;,&quot;name_ru&quot;,&quot;parent&quot;)

SELECT 'Sharbat','Соки', p.id

FROM &quot;category&quot; p

WHERE p.parent IS NULL AND p.name_uz='Ichimliklar'

